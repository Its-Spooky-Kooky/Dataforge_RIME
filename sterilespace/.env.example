# ==============================================================================
# SterileSpace - Cleanroom Laboratory Voice Operating Copilot
# Environment Configuration
# ==============================================================================

# LiveKit WebRTC Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

# Rime Cloud TTS Configuration
# Model options: coda (ultra-low latency), mist (v3 expressive)
# Speaker options: astra, luna, etc.
RIME_API_KEY=your_rime_api_key
RIME_MODEL_ID=coda
RIME_SPEAKER=astra

# LLM Configuration for Agent Worker
OPENAI_API_KEY=your_openai_key

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

